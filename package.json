{
  "name": "minewalker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --check .",
    "e2e": "powershell -ExecutionPolicy Bypass -File scripts/run-e2e.ps1",
    "verify:encoding": "node scripts/verify-encoding.mjs",
    "e2e:performance": "powershell -ExecutionPolicy Bypass -File scripts/run-e2e.ps1 --grep performance"
  },
  "dependencies": {
    "@fontsource/noto-sans-jp": "^5.2.8",
    "phaser": "^3.90.0",
    "seedrandom": "^3.0.5",
    "vite-plugin-pwa": "^1.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@playwright/test": "^1.54.1",
    "@types/node": "^22.13.14",
    "@types/seedrandom": "^3.0.8",
    "eslint": "^9.31.0",
    "globals": "^15.15.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0",
    "vite": "^7.0.5",
    "vitest": "^3.2.4"
  }
}
